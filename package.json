        "build": "astro check && astro build",
        "build:app": "astro build",
        "preview": "astro preview",
        "typecheck": "astro check",
        "lint": "eslint .",
        "check:trailing-slashes": "node scripts/check-trailing-slashes.js",
        "check:color-copies": "node scripts/check-color-copies.mjs",
        "check:font-preloads": "node scripts/check-font-preloads.mjs",
        "check:inline-module-scripts": "node scripts/check-inline-module-scripts.mjs",
        "check:favicons": "node scripts/check-favicons.mjs",
        "check:page-coverage": "node scripts/check-page-coverage.mjs",
        "check:csp": "node scripts/check-csp.mjs",
        "check:learnings": "node scripts/check-learnings.mjs",
        "check:audit": "npm audit --omit=dev --audit-level=high",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "test:contrast": "playwright test --config=playwright.contrast.config.ts",
        "test:functions": "playwright test --config=playwright.functions.config.ts",
