        "js-yaml": "^5.5.0",
        "lucide-react": "^1.63.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "satori": "^0.63.2",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/typography": "^0.5.20",
