        "prettier-plugin-tailwindcss": "^0.8.1",
        "prettier-plugin-toml": "^3.0.2",
        "robots-parser": "^3.0.1",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "overrides": {
