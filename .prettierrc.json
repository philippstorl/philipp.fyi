{
    "tabWidth": 4,
    "singleQuote": true,
    "semi": false,
    "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./src/styles/global.css",
    "overrides": [
        {
            "files": "*.astro",
            "options": {
                "parser": "astro"
            }
        },
        {
            "files": ["*.css", "*.md", "*.mdx", "*.yml", "*.yaml"],
            "options": {
                "singleQuote": false
            }
        }
    ]
}
