{
    "permissions": {
        "allow": [
            "Bash(npm run lint)",
            "Bash(npm run typecheck)",
            "Bash(npm run build)",
            "Bash(npm test)",
            "Bash(npm run check:trailing-slashes)",
            "Bash(npm run format)",
            "Bash(npm run format:check)",
            "Bash(git status)",
            "Bash(git status *)",
            "Bash(git diff)",
            "Bash(git diff *)",
            "Bash(git log)",
            "Bash(git log *)"
        ]
    },
    "hooks": {
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node scripts/check-doc-sync.js 2>/dev/null || true",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
