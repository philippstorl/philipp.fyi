---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import SocialIcon from '@/components/ui/SocialIcon.astro'
import NewTabIndicator from '@/components/ui/NewTabIndicator.astro'
import ContactForm from '@/components/ui/ContactForm'
import { hero, type HeroLink } from '@/data/hero'

// Keyed by icon so TS forces an update if hero.links gains a third entry.
const contactLinkLabels: Record<HeroLink['icon'], string> = {
    linkedin: 'Connect on LinkedIn',
    github: 'Browse my code on GitHub',
}
---

<BaseLayout
    title="Contact"
    description="Get in touch with Philipp Storl, available for remote, full-stack web development work worldwide."
    ogImage="/og/contact.png"
>
    <Header />
    <Main>
        <PageHeader eyebrow="Get in touch" title="Contact">
            Whether you have a role in mind, a project to discuss, or just want
            to connect, I'd love to hear from you.
        </PageHeader>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            {
                /* Hidden form registers with Netlify's deploy-time spider;
                ContactForm handles the real submission via fetch(). */
            }
            <form
                name="contact"
                data-netlify="true"
                data-netlify-honeypot="bot-field"
                hidden
            >
                <input type="text" name="name" />
                <input type="email" name="email" />
                <textarea name="message"></textarea>
            </form>

            <p class="mb-8 text-sm text-muted">
                Based in Chemnitz / Leipzig area, Germany. Available for remote
                work worldwide.
            </p>

            <ContactForm client:load />

            <div class="mt-10 flex flex-wrap items-center gap-3">
                {
                    hero.links.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 rounded-full border border-border-strong px-5 py-2.5 text-sm font-medium text-foreground transition-colors duration-150 hover:border-accent hover:text-accent"
                        >
                            <SocialIcon icon={link.icon} size={15} />
                            {contactLinkLabels[link.icon]}
                            <NewTabIndicator />
                        </a>
                    ))
                }
            </div>
        </div>
    </Main>
    <Footer />
</BaseLayout>
