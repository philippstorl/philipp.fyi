---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)
---

<BaseLayout
    title="Blog"
    description="Writing on web development, tooling, and building things that last."
>
    <Header />
    <Main class="mx-auto max-w-3xl px-6 py-24 md:py-32">
        <h1
            class="mb-12 font-display text-4xl font-normal tracking-tight text-foreground md:text-5xl"
            style="font-variation-settings: 'opsz' 72"
        >
            Blog
        </h1>

        {
            posts.length === 0 ? (
                <p class="text-base text-muted">Writing coming soon.</p>
            ) : (
                <ol class="flex flex-col divide-y divide-border">
                    {posts.map((post) => {
                        const href = `/blog/${post.id.replace(/\.(mdx?|md)$/, '')}/`
                        return (
                            <li class="py-8">
                                <time
                                    datetime={post.data.date.toISOString()}
                                    class="mb-2 block font-mono text-xs text-muted"
                                >
                                    {post.data.date.toLocaleDateString(
                                        'en-GB',
                                        {
                                            day: 'numeric',
                                            month: 'long',
                                            year: 'numeric',
                                        },
                                    )}
                                </time>
                                <a href={href} class="group relative block">
                                    <h2
                                        class="mb-2 font-display text-xl font-normal tracking-tight text-foreground transition-colors duration-150 group-hover:text-accent after:absolute after:inset-0"
                                        style="font-variation-settings: 'opsz' 24"
                                    >
                                        {post.data.title}
                                    </h2>
                                    <p class="text-sm leading-relaxed text-muted">
                                        {post.data.description}
                                    </p>
                                </a>
                            </li>
                        )
                    })}
                </ol>
            )
        }
    </Main>
    <Footer />
</BaseLayout>
