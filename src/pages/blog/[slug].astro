---
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import { PROSE_BLOCKQUOTE_CLASSES } from '@/utils/prose'
import { stripContentExtension } from '@/utils/slug'
import { formatBlogDate } from '@/utils/date'

export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => !data.draft)
    return posts.map((post) => ({
        params: { slug: stripContentExtension(post.id) },
        props: { post },
    }))
}

const { post } = Astro.props
const { Content } = await render(post)
const { title, description, date, tags } = post.data
---

<BaseLayout title={title} description={description}>
    <Header />
    <Main class="mx-auto max-w-3xl px-6 py-24">
        <a
            href="/blog/"
            class="mb-12 inline-flex items-center gap-1.5 text-sm text-muted transition-colors duration-150 hover:text-accent"
        >
            ← All posts
        </a>

        <header class="mt-10 mb-12">
            <time
                datetime={date.toISOString()}
                class="mb-5 block font-mono text-xs text-muted"
            >
                {formatBlogDate(date)}
            </time>
            <h1
                class="opsz-72 mb-6 font-display text-4xl leading-tight font-normal tracking-tight text-foreground md:text-5xl"
            >
                {title}
            </h1>
            {
                tags.length > 0 && (
                    <ul class="flex flex-wrap gap-2">
                        {tags.map((tag) => (
                            <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">
                                {tag}
                            </li>
                        ))}
                    </ul>
                )
            }
        </header>

        <hr class="mb-12 border-border" />

        <div
            class={`prose max-w-none prose-neutral dark:prose-invert prose-headings:font-display prose-headings:font-normal prose-headings:tracking-tight prose-a:text-accent prose-a:no-underline hover:prose-a:underline ${PROSE_BLOCKQUOTE_CLASSES} prose-code:font-mono prose-code:text-sm`}
        >
            <Content />
        </div>

        <div class="mt-20 border-t border-border pt-10">
            <a
                href="/blog/"
                class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors duration-150 hover:text-accent"
            >
                ← All posts
            </a>
        </div>
    </Main>
    <Footer />
</BaseLayout>
