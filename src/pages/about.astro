---
import { Image } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import CareerTimeline from '@/components/about/CareerTimeline.astro'
import InterlinkRow from '@/components/ui/InterlinkRow.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import portrait from '@/assets/philipp-storl.jpg'
import { about } from '@/data/about'
import { CURRENT_EMPLOYER } from '@/data/employer'
import { JOB_TITLE } from '@/data/hero'
import { stack } from '@/data/stack'
import { getDefaultDescription } from '@/data/site'
import { staticPageMeta } from '@/data/static-pages'
---

<BaseLayout {...staticPageMeta('about')} description={getDefaultDescription()}>
    <Header />
    <Main>
        <PageHeader eyebrow="Who I am" title="About">
            Philipp Storl, {JOB_TITLE} at {CURRENT_EMPLOYER.name}, based in the
            Chemnitz / Leipzig area, Germany.
        </PageHeader>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            <div class="flex flex-col gap-8 md:flex-row md:items-start">
                <Image
                    src={portrait}
                    alt="Philipp Storl holding his Berlin Half Marathon 2026 medal in front of the Brandenburg Gate"
                    width={144}
                    height={144}
                    densities={[1, 2, 3]}
                    loading="eager"
                    class="size-36 shrink-0 rounded-full object-cover"
                />
                <div class="space-y-5">
                    {about.paragraphs.map((para) => <p
                        class="text-base leading-relaxed text-muted md:text-lg"
                    >
                        {para}
                    </p>)}
                </div>
            </div>

            <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
                {about.facts.map((fact) => <div
                    class="rounded-xl border border-border bg-card px-4 py-3.5"
                >
                    <dt class="text-xs font-medium text-muted">
                        {fact.label}
                    </dt>
                    <dd class="mt-1 text-sm text-foreground">
                        {fact.value}
                    </dd>
                </div>)}
            </dl>

            <h2
                class="mt-16 mb-4 font-display text-2xl leading-snug font-bold tracking-tight text-foreground md:text-3xl"
            >
                How this site is built
            </h2>
            <ul class="flex flex-wrap gap-2">
                {stack.map((name) => <li
                    class="rounded-full border border-border px-2.5 py-0.5 font-mono text-xs text-muted"
                >
                    {name}
                </li>)}
            </ul>

            <CareerTimeline />

            <InterlinkRow
                class="mt-16"
                items={[
                    {
                        href: '/work/',
                        eyebrow: 'See it put into practice',
                        label: 'Work',
                    },
                    {
                        href: '/principles/',
                        eyebrow: 'See how this plays out',
                        label: 'Principles',
                    },
                    {
                        href: '/recommendations/',
                        eyebrow: 'Hear it from people I’ve worked with',
                        label: 'Recommendations',
                    },
                ]}
            />
        </div>
    </Main>
    <Footer />
</BaseLayout>
