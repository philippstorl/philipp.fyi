---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import InterlinkRow from '@/components/ui/InterlinkRow.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import { about } from '@/data/about'
import { stack } from '@/data/stack'
import {
    getStaffbaseTenureYears,
    getYearsOfExperience,
} from '@/utils/experience'
---

<BaseLayout
    title="About"
    description={`Principal Web Developer with ${getYearsOfExperience()} years in web development, ${getStaffbaseTenureYears()} of them scaling staffbase.com. Full-stack, DevOps, and design. Chemnitz / Leipzig area, remote-first.`}
    ogImage="/og/about.png"
>
    <Header />
    <Main>
        <PageHeader eyebrow="Who I am" title="About">
            Philipp Storl, Principal Web Developer based in the Chemnitz /
            Leipzig area, Germany.
        </PageHeader>

        <div class="mx-auto max-w-3xl px-6 pb-24">
            <div class="space-y-5">
                {
                    about.paragraphs.map((para) => (
                        <p class="text-base leading-relaxed text-muted md:text-lg">
                            {para}
                        </p>
                    ))
                }
            </div>

            <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
                {
                    about.facts.map((fact) => (
                        <div class="rounded-xl border border-border bg-card px-4 py-3.5">
                            <dt class="text-xs font-medium text-muted">
                                {fact.label}
                            </dt>
                            <dd class="mt-1 text-sm text-foreground">
                                {fact.value}
                            </dd>
                        </div>
                    ))
                }
            </dl>

            <InterlinkRow
                class="mt-10"
                items={[
                    {
                        href: '/work/',
                        eyebrow: 'See it put into practice',
                        label: 'Work',
                    },
                    {
                        href: '/principles/',
                        eyebrow: 'See how this plays out',
                        label: 'Principles',
                    },
                    {
                        href: '/recommendations/',
                        eyebrow: "Hear it from people I've worked with",
                        label: 'Recommendations',
                    },
                ]}
            />
        </div>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            <h2
                class="mb-4 font-display text-2xl leading-snug font-normal tracking-tight text-foreground md:text-3xl"
                style="font-variation-settings: 'opsz' 36"
            >
                How this site is built
            </h2>
            <p class="mb-6 text-base leading-relaxed text-muted">
                This site is itself a small example of the same approach:
                static-first with Astro, JavaScript only for the two components
                that actually need it, and linted for accessibility on every
                push.
            </p>
            <ul class="flex flex-wrap gap-2">
                {
                    stack.map((item) => (
                        <li
                            class="rounded-full border border-border px-2.5 py-0.5 font-mono text-xs text-muted"
                            title={item.role}
                        >
                            {item.name}
                        </li>
                    ))
                }
            </ul>
        </div>
    </Main>
    <Footer />
</BaseLayout>
