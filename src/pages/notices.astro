---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import NewTabIndicator from '@/components/ui/NewTabIndicator.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import { thirdPartyNotices } from '@/data/third-party-notices'
---

<BaseLayout
    title="Third-party notices"
    description="License notices for the open-source software bundled into this site's client-side JavaScript."
>
    <Header />
    <Main>
        <PageHeader eyebrow="Legal" title="Third-party notices">
            This site's client-side JavaScript bundles a small number of
            open-source packages. Their license and copyright notices are
            reproduced below.
        </PageHeader>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            <div class="flex flex-col gap-6">
                {
                    thirdPartyNotices.map((group) => (
                        <div class="rounded-xl border border-border bg-card p-8 md:p-10">
                            <h2 class="font-display text-xl leading-snug font-normal tracking-tight text-foreground">
                                {group.licenseName}
                            </h2>
                            <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1">
                                {group.packages.map((pkg) => (
                                    <li class="text-sm text-muted">
                                        <a
                                            href={pkg.homepage}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="font-medium text-foreground underline decoration-border-strong underline-offset-2 hover:text-accent"
                                        >
                                            {pkg.name}
                                            <NewTabIndicator />
                                        </a>
                                        : {pkg.role}
                                    </li>
                                ))}
                            </ul>
                            <p class="mt-6 text-sm text-muted">
                                {group.copyright}
                            </p>
                            <div class="mt-3 space-y-3 text-sm leading-relaxed text-muted">
                                {group.text.split('\n\n').map((paragraph) => (
                                    <p>{paragraph}</p>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </Main>
    <Footer />
</BaseLayout>
