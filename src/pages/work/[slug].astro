---
import { render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import CaseStudyLayout from '@/components/work/CaseStudyLayout.astro'
import { getPublishedEntries } from '@/utils/collections'
import { stripContentExtension } from '@/utils/slug'

export async function getStaticPaths() {
    const entries = await getPublishedEntries('work')
    return entries.map((entry) => ({
        params: { slug: stripContentExtension(entry.id) },
        props: { entry },
    }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const { title, description, category, tags, year } = entry.data
const slug = stripContentExtension(entry.id)
const ogImage = `/og/work/${slug}.png`
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
    <Header />
    <Main>
        <CaseStudyLayout
            title={title}
            description={description}
            category={category}
            year={year}
            tags={tags}
            ogImage={ogImage}
        >
            <Content />
        </CaseStudyLayout>
    </Main>
    <Footer />
</BaseLayout>
