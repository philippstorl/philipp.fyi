---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import InterlinkRow from '@/components/ui/InterlinkRow.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import WorkGrid from '@/components/work/WorkGrid.astro'
import { getPublishedEntries } from '@/utils/collections'
import {
    getStaffbaseTenureYears,
    getYearsOfExperience,
} from '@/utils/experience'

const caseStudyCount = (await getPublishedEntries('work')).length
---

<BaseLayout
    title="Work"
    description={`Case studies from ${getYearsOfExperience()} years building for the web, including ${getStaffbaseTenureYears()} years scaling staffbase.com.`}
    ogImage="/og/work.png"
>
    <Header />
    <Main>
        <PageHeader eyebrow="Selected work" title="Work">
            {caseStudyCount} projects across engineering, design, and leadership,
            each with the decisions and trade-offs behind it.
        </PageHeader>

        <div class="mx-auto max-w-6xl px-6 pb-24">
            <WorkGrid eagerLoadFirst headingLevel="h2" />
        </div>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            <InterlinkRow
                items={[
                    {
                        href: '/about/',
                        eyebrow: 'Meet the person behind it',
                        label: 'About',
                    },
                    {
                        href: '/principles/',
                        eyebrow: 'The principles behind these projects',
                        label: 'Principles',
                    },
                    {
                        href: '/recommendations/',
                        eyebrow: 'Hear from the people I built it with',
                        label: 'Recommendations',
                    },
                ]}
            />
        </div>
    </Main>
    <Footer />
</BaseLayout>
