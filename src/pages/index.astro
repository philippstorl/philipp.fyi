---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import Hero from '@/components/home/Hero.astro'
import WorkSection from '@/components/home/WorkSection.astro'
import AboutSection from '@/components/home/AboutSection.astro'
import PrinciplesSection from '@/components/home/PrinciplesSection.astro'
import RecommendationsSection from '@/components/home/RecommendationsSection.astro'
import ContactSection from '@/components/home/ContactSection.astro'
import {
    getStaffbaseTenureYears,
    getYearsOfExperience,
} from '@/utils/experience'
---

<BaseLayout
    description={`Principal Web Developer, full-stack, DevOps, and design in one. ${getYearsOfExperience()} years building for the web, ${getStaffbaseTenureYears()} of them turning staffbase.com into a platform serving millions. Remote-first, Chemnitz / Leipzig area.`}
>
    <Header />
    <Main>
        <Hero />
        <WorkSection />
        <AboutSection />
        <PrinciplesSection />
        <RecommendationsSection />
        <ContactSection />
    </Main>
    <Footer />
</BaseLayout>
