---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import Hero from '@/components/home/Hero.astro'
import WorkSection from '@/components/home/WorkSection.astro'
import AboutSection from '@/components/home/AboutSection.astro'
import PrinciplesSection from '@/components/home/PrinciplesSection.astro'
import RecommendationsSection from '@/components/home/RecommendationsSection.astro'
import ContactSection from '@/components/home/ContactSection.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import { getPrimaryDescription } from '@/data/site'
import { buildPersonSchema } from '@/utils/schema'
import { toAbsoluteUrl } from '@/utils/url'

const personSchema = buildPersonSchema(
    toAbsoluteUrl(Astro.url.pathname, Astro.site),
)
---

<BaseLayout description={getPrimaryDescription()}>
    <JsonLd data={personSchema} />
    <Header />
    <Main>
        <Hero />
        <WorkSection />
        <AboutSection />
        <PrinciplesSection />
        <RecommendationsSection />
        <ContactSection />
    </Main>
    <Footer />
</BaseLayout>
