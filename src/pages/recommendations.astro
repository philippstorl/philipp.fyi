---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import InitialsAvatar from '@/components/ui/InitialsAvatar.astro'
import InterlinkCard from '@/components/ui/InterlinkCard.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import { recommendations } from '@/data/recommendations'
import { PROSE_BLOCKQUOTE_CLASSES } from '@/utils/prose'
---

<BaseLayout
    title="Recommendations"
    description="What colleagues, managers, and partners have said about working with Philipp Storl."
    ogImage="/og/recommendations.png"
>
    <Header />
    <Main>
        <PageHeader eyebrow="What others say" title="Recommendations">
            Recommendations from colleagues, managers, direct reports, and
            external partners I've worked with over the years, collected from{
                ' '
            }
            <a
                href="https://www.linkedin.com/in/philipp-storl/details/recommendations/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent no-underline hover:underline"
            >
                LinkedIn
            </a>, unedited except for formatting.
        </PageHeader>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            <ol class="flex flex-col gap-4">
                {
                    recommendations.map((r) => (
                        <li
                            id={r.slug}
                            class="scroll-mt-24 rounded-xl border border-border bg-card p-8 md:p-10"
                        >
                            <div class="mb-6 flex items-center gap-4">
                                <InitialsAvatar
                                    name={r.name}
                                    class="h-12 w-12 text-base"
                                />
                                <div>
                                    <h2
                                        class="font-display text-xl leading-snug font-normal tracking-tight text-foreground"
                                        style="font-variation-settings: 'opsz' 24"
                                    >
                                        {r.name}
                                    </h2>
                                    <p class="text-sm text-muted">{r.title}</p>
                                    <p class="text-sm text-muted">
                                        {r.relationship} · {r.date}
                                    </p>
                                </div>
                            </div>
                            <div
                                class={`prose max-w-none text-muted prose-neutral dark:prose-invert ${PROSE_BLOCKQUOTE_CLASSES} prose-blockquote:[quotes:none]`}
                            >
                                <blockquote>
                                    {r.quote.map((paragraph) => (
                                        <p>{paragraph}</p>
                                    ))}
                                </blockquote>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </div>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <InterlinkCard
                    href="/about/"
                    eyebrow="Meet the person they describe"
                    label="About"
                />
                <InterlinkCard
                    href="/principles/"
                    eyebrow="The principles behind the work"
                    label="Principles"
                />
                <InterlinkCard
                    href="/work/"
                    eyebrow="The projects these people are describing"
                    label="Work"
                />
            </div>
        </div>
    </Main>
    <Footer />
</BaseLayout>
