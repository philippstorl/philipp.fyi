---
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Header from '@/components/layout/Header.astro'
import Main from '@/components/layout/Main.astro'
import Footer from '@/components/layout/Footer.astro'
import InterlinkRow from '@/components/ui/InterlinkRow.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import { getYearsOfExperience } from '@/utils/experience'
import { stripContentExtension } from '@/utils/slug'

const principles = (await getCollection('principles')).sort((a, b) =>
    a.id.localeCompare(b.id),
)
const years = getYearsOfExperience()
---

<BaseLayout
    title="Principles"
    description="Fifteen things I hold close: how I think about work, quality, people, and building things that last."
    ogImage="/og/principles.png"
>
    <Header />
    <Main>
        <PageHeader eyebrow="How I work" title="Principles">
            These aren't principles I wrote down once and then tried to follow.
            They're patterns that emerged from {years} years of decisions, conversations,
            mistakes, and a consistent attempt to act with integrity even when it
            wasn't the convenient choice.
        </PageHeader>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            <ol class="flex flex-col gap-4">
                {
                    principles.map(async (entry) => {
                        const { Content } = await render(entry)
                        const number = entry.id.split('-')[0]
                        const slug = stripContentExtension(entry.id)
                        return (
                            <li
                                id={slug}
                                class="scroll-mt-24 rounded-xl border border-border bg-card p-8 md:p-10"
                            >
                                <span class="mb-4 block font-mono text-xs text-muted">
                                    {number}
                                </span>
                                <h2 class="mb-4 font-display text-2xl leading-snug font-bold tracking-tight text-foreground md:text-3xl">
                                    {entry.data.title}
                                </h2>
                                <div class="prose max-w-none text-muted prose-neutral dark:prose-invert">
                                    <Content />
                                </div>
                            </li>
                        )
                    })
                }
            </ol>
        </div>

        <div class="mx-auto max-w-3xl px-6 pb-32">
            <InterlinkRow
                items={[
                    {
                        href: '/about/',
                        eyebrow: 'Meet the person behind them',
                        label: 'About',
                    },
                    {
                        href: '/work/',
                        eyebrow: 'Where these ideas show up',
                        label: 'Work',
                    },
                    {
                        href: '/recommendations/',
                        eyebrow: 'See these principles in practice',
                        label: 'Recommendations',
                    },
                ]}
            />
        </div>
    </Main>
    <Footer />
</BaseLayout>
