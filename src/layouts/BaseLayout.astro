---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
// Preloaded below since Fraunces renders the hero <h1> (the page's likely
// LCP element) but is otherwise only discovered via global.css's @import
// chain, costing an extra round trip. The `-latin-` subset covers this
// site's English copy; the `?url` suffix resolves Vite's hashed build
// output path rather than the raw node_modules path. Both DM Sans weights
// actually painted above the fold are preloaded: 500 for the header nav
// links (NavLink.astro) and hero availability badge, and 400 for the hero
// subheading paragraph (Hero.astro's <p class="text-lg ...">) right below
// the <h1> — self-review caught that an earlier version of this only
// preloaded 500, missing the subheading despite it being above the fold too.
import frauncesWoff2Url from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url'
import dmSansWoff2Url from '@fontsource/dm-sans/files/dm-sans-latin-500-normal.woff2?url'
import dmSansRegularWoff2Url from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url'
import { SITE_NAME, getDefaultDescription } from '@/data/site'
import { toAbsoluteUrl } from '@/utils/url'

interface Props {
    /** Page title — shown as "Title | Philipp Storl", omit for home page */
    title?: string
    description?: string
    ogImage?: string
    ogType?: 'website' | 'article'
    /** ISO 8601 date/datetime; only rendered when ogType is 'article'. */
    articlePublishedTime?: string
}

const {
    title,
    description = getDefaultDescription(),
    ogImage = '/og/home.png',
    ogType = 'website',
    articlePublishedTime,
} = Astro.props

const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME
const canonicalURL = toAbsoluteUrl(Astro.url.pathname, Astro.site)
const ogImageURL = toAbsoluteUrl(ogImage, Astro.site)
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${SITE_NAME} Blog`}
            href="/rss.xml"
        />

        <meta property="og:type" content={ogType} />
        {
            ogType === 'article' && articlePublishedTime && (
                <meta
                    property="article:published_time"
                    content={articlePublishedTime}
                />
            )
        }
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:site_name" content={SITE_NAME} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        <meta
            name="theme-color"
            media="(prefers-color-scheme: light)"
            content="#FAF9F6"
        />
        <meta
            name="theme-color"
            media="(prefers-color-scheme: dark)"
            content="#0C0B09"
        />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={frauncesWoff2Url}
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={dmSansWoff2Url}
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href={dmSansRegularWoff2Url}
            crossorigin
        />

        <ClientRouter />

        {
            /*
            Dark mode: runs synchronously before first paint to prevent flash.
            Reads localStorage, falls back to OS preference. Also reapplied on
            astro:after-swap, since the view-transitions router replaces the
            <html> element's attributes (including class) with the incoming
            page's static markup, which doesn't have the class baked in.
        */
        }
        <script is:inline>
            ;(function () {
                function applyStoredTheme() {
                    const stored = localStorage.getItem('theme')
                    const prefersDark = window.matchMedia(
                        '(prefers-color-scheme: dark)',
                    ).matches
                    document.documentElement.classList.toggle(
                        'dark',
                        stored === 'dark' || (!stored && prefersDark),
                    )
                }
                applyStoredTheme()
                document.addEventListener('astro:after-swap', applyStoredTheme)
            })()
        </script>
    </head>

    <body class="bg-background font-sans text-foreground">
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-lg focus:border focus:border-border focus:bg-card focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-foreground"
        >
            Skip to main content
        </a>
        <slot />
    </body>
</html>
