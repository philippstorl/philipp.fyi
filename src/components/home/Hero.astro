---
import { Image } from 'astro:assets'
import SocialIcon from '@/components/ui/SocialIcon.astro'
import { hero } from '@/data/hero'
// Flat package-style graphic with its own light background baked in —
// intentionally does not adapt to the dark/light toggle, unlike the
// rest of the page. The card wrapper below is what keeps it looking
// intentional on a dark background, not a theme-conditional image swap.
import heroFigure from '@/assets/hero-figure.png'
---

<section
    aria-label="Introduction"
    class="mx-auto max-w-6xl px-6 py-28 md:py-36 lg:py-44"
>
    <div
        class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1fr_minmax(320px,420px)] lg:gap-16"
    >
        <div>
            <!-- Availability badge -->
            {
                hero.available && (
                    <div class="mb-10 animate-fade-up">
                        <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 px-3.5 py-1 text-xs font-medium text-accent">
                            <span class="size-1.5 rounded-full bg-accent" />
                            {hero.availabilityText}
                        </span>
                    </div>
                )
            }

            <!-- Headline -->
            <h1
                class="mb-6 max-w-4xl animate-fade-up font-display text-5xl leading-[1.05] font-normal tracking-tight text-foreground [animation-delay:100ms] md:text-6xl lg:text-7xl"
                style="font-variation-settings: 'opsz' 80"
            >
                {hero.headline}
            </h1>

            <!-- Description -->
            <div class="mb-10 max-w-xl animate-fade-up [animation-delay:200ms]">
                <p class="text-lg leading-relaxed text-muted">
                    {hero.subheading}
                    <br />
                    {hero.description}
                    <br />
                    {hero.experienceTagline}
                </p>
                <p class="mt-3 text-sm text-muted/70">
                    {hero.location}
                </p>
            </div>

            <!-- CTAs -->
            <div
                class="flex animate-fade-up flex-wrap items-center gap-3 [animation-delay:300ms]"
            >
                {
                    hero.links.map((link) => (
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-medium text-foreground transition-colors duration-150 hover:border-accent hover:text-accent"
                        >
                            <SocialIcon icon={link.icon} size={15} />
                            {link.label}
                        </a>
                    ))
                }
            </div>
        </div>

        <!-- Figure — max-w-[320px] here matches the grid track's 320px lower
        bound above; keep both in sync if the source image's size changes -->
        <div
            class="mx-auto w-full max-w-[320px] animate-fade-up overflow-hidden rounded-xl border border-border bg-card p-6 [animation-delay:150ms] lg:max-w-none"
        >
            <Image
                src={heroFigure}
                alt="Philipp Storl, Principal Web Developer, shown as a collectible action figure with a laptop, running shoe, and two cats."
                width={840}
                loading="eager"
                fetchpriority="high"
                class="h-auto w-full object-contain"
            />
        </div>
    </div>
</section>
