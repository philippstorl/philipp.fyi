---
import SocialIcon from '@/components/ui/SocialIcon.astro'
import { hero } from '@/data/hero'
---

<section
    aria-label="Introduction"
    class="mx-auto max-w-6xl px-6 py-32 md:py-44 lg:py-52"
>
    {
        hero.available && (
            <div class="mb-10 animate-fade-up">
                <span class="inline-flex items-center gap-2 rounded-full border border-available/30 px-3.5 py-1 text-xs font-medium text-available">
                    <span class="animate-dot-breathe size-1.5 rounded-full bg-available" />
                    {hero.availabilityText}
                </span>
            </div>
        )
    }

    <h1
        class="opsz-80 mb-6 max-w-4xl animate-fade-up font-display text-5xl leading-[1.05] font-normal tracking-tight text-foreground [animation-delay:100ms] md:text-6xl lg:text-7xl"
    >
        {hero.headline}
    </h1>

    <div class="mb-10 max-w-xl animate-fade-up [animation-delay:200ms]">
        <p class="text-lg leading-relaxed text-muted">
            {hero.subheading}
            <br />
            {hero.description}
            <br />
            {hero.experienceTagline}
        </p>
        <p class="mt-3 text-sm text-muted">
            {hero.location}
        </p>
    </div>

    <div
        class="flex animate-fade-up flex-wrap items-center gap-3 [animation-delay:300ms]"
    >
        {
            hero.links.map((link) => (
                <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-full border border-border-strong px-5 py-2.5 text-sm font-medium text-foreground transition-colors duration-150 hover:border-accent hover:text-accent"
                >
                    <SocialIcon icon={link.icon} size={15} />
                    {link.label}
                </a>
            ))
        }
    </div>
</section>
