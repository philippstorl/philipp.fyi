---
import SectionHeader from './SectionHeader.astro'

const headingId = 'contact-heading'
---

<section
    id="contact"
    aria-labelledby={headingId}
    class="mx-auto max-w-6xl px-6 py-24 md:py-32"
>
    <SectionHeader
        headingId={headingId}
        heading="Let’s talk"
        href="/contact/"
        label="Send me a message"
    />

    <p class="max-w-xl text-base leading-relaxed text-muted md:text-lg">
        Have a question, an idea, or just want to connect? I’d love to hear from
        you.
    </p>
</section>
