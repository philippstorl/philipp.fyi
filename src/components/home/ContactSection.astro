---
import SectionHeader from './SectionHeader.astro'

const headingId = 'contact-heading'
---

<section
    id="contact"
    aria-labelledby={headingId}
    class="mx-auto max-w-6xl px-6 py-24 md:py-32"
>
    <SectionHeader
        headingId={headingId}
        heading="Get in touch"
        href="/contact/"
        label="Send me a message"
    />

    <p class="max-w-xl text-base leading-relaxed text-muted md:text-lg">
        Whether you have a role in mind, a project to discuss, or just want to
        connect, I'd love to hear from you.
    </p>
</section>
