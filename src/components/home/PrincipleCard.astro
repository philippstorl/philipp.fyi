---
import type { CollectionEntry } from 'astro:content'
import { stripContentExtension } from '@/utils/slug'

interface Props {
    entry: CollectionEntry<'principles'>
}

const { entry } = Astro.props
const { title, description } = entry.data
const slug = stripContentExtension(entry.id)
const number = slug.split('-')[0]
const href = `/principles/#${slug}`
---

{
    /* Card uses the stretched-link pattern — see WorkCard.astro for the rationale. */
}
<article
    class:list={[
        'group relative flex cursor-pointer flex-col rounded-xl border border-border bg-card p-6',
        'transition-colors duration-200 hover:border-accent/40',
        'focus-within:ring-2 focus-within:ring-accent focus-within:ring-offset-2 focus-within:ring-offset-background',
    ]}
>
    <span class="mb-4 font-mono text-xs text-muted">{number}</span>

    <h3
        class="opsz-24 mb-3 font-display text-lg leading-snug font-normal tracking-tight text-foreground transition-colors duration-150 group-hover:text-accent"
    >
        <a
            href={href}
            data-astro-prefetch
            class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none"
        >
            {title}
        </a>
    </h3>

    <p class="text-sm leading-relaxed text-muted">
        {description}
    </p>
</article>
