---
import WorkGrid from '@/components/work/WorkGrid.astro'
import SectionHeader from './SectionHeader.astro'

const headingId = 'work-heading'
---

<section
    id="work"
    aria-labelledby={headingId}
    class="mx-auto max-w-6xl px-6 py-24 md:py-32"
>
    <SectionHeader
        headingId={headingId}
        heading="Selected work"
        href="/work/"
        label="See all work"
    />

    <WorkGrid />
</section>
