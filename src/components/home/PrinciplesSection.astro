---
import { getCollection } from 'astro:content'
import PrincipleCard from './PrincipleCard.astro'
import SectionHeader from './SectionHeader.astro'

// Sort by entry.id — the filename prefix (01-, 02-, …) determines order.
// To reorder: rename the file. No frontmatter to touch.
const all = (await getCollection('principles')).sort((a, b) =>
    a.id.localeCompare(b.id),
)

const preview = all.slice(0, 6)
const totalCount = all.length

const headingId = 'principles-heading'
---

<section
    id="principles"
    aria-labelledby={headingId}
    class="mx-auto max-w-6xl px-6 py-24 md:py-32"
>
    <SectionHeader
        headingId={headingId}
        heading="How I work"
        href="/principles/"
        label={`Read all ${totalCount} principles`}
    />

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {preview.map((entry) => <PrincipleCard entry={entry} />)}
    </div>
</section>
