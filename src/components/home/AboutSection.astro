---
import { about } from '@/data/about'
import { ArrowRight } from 'lucide-react'
---

<section
    id="about"
    aria-labelledby="about-heading"
    class="mx-auto max-w-6xl px-6 py-24 md:py-32"
>
    <div
        class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
        <h2
            id="about-heading"
            class="font-display text-3xl font-normal tracking-tight text-foreground md:text-4xl"
            style="font-variation-settings: 'opsz' 48"
        >
            About
        </h2>
        <a
            href="/about/"
            data-astro-prefetch
            class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-muted transition-colors duration-150 hover:text-accent"
        >
            Read more about me
            <ArrowRight
                size={14}
                strokeWidth={1.75}
                className="transition-transform duration-150 group-hover:translate-x-0.5"
            />
        </a>
    </div>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-5">
        <div class="space-y-5 md:col-span-3">
            {
                about.paragraphs.map((para) => (
                    <p class="text-base leading-relaxed text-muted md:text-lg">
                        {para}
                    </p>
                ))
            }
        </div>

        <div class="md:col-span-2">
            <dl
                class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-card"
            >
                {
                    about.facts.map((fact) => (
                        <div class="flex items-baseline justify-between gap-4 px-5 py-3.5">
                            <dt class="shrink-0 text-xs font-medium text-muted">
                                {fact.label}
                            </dt>
                            <dd class="text-right text-sm text-foreground">
                                {fact.value}
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </div>
</section>
