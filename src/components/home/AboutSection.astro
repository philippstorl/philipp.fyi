---
import { about } from '@/data/about'
import SectionHeader from './SectionHeader.astro'

const headingId = 'about-heading'
---

<section
    id="about"
    aria-labelledby={headingId}
    class="mx-auto max-w-6xl px-6 py-24 md:py-32"
>
    <SectionHeader
        headingId={headingId}
        heading="About"
        href="/about/"
        label="Read more about me"
    />

    <div class="grid grid-cols-1 gap-12 md:grid-cols-5">
        <div class="space-y-5 md:col-span-3">
            {
                about.paragraphs.map((para) => (
                    <p class="text-base leading-relaxed text-muted md:text-lg">
                        {para}
                    </p>
                ))
            }
        </div>

        <div class="md:col-span-2">
            <dl
                class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-card"
            >
                {
                    about.facts.map((fact) => (
                        <div class="flex items-baseline justify-between gap-4 px-5 py-3.5">
                            <dt class="shrink-0 text-xs font-medium text-muted">
                                {fact.label}
                            </dt>
                            <dd class="text-right text-sm text-foreground">
                                {fact.value}
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </div>
</section>
