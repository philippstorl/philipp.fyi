---
interface Props {
    eyebrow: string
    title: string
}

const { eyebrow, title } = Astro.props
---

<div class="mx-auto max-w-3xl px-6 pt-24 pb-16 md:pt-32">
    <p class="mb-4 text-sm font-medium text-muted">{eyebrow}</p>
    <h1
        class="mb-6 font-display text-4xl leading-tight font-bold tracking-tight break-words text-foreground md:text-5xl"
    >
        {title}
    </h1>
    <p class="text-lg leading-relaxed text-muted">
        <slot />
    </p>
</div>
