---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import ResponsiveImage, {
    type ResponsiveImageSizing,
} from './ResponsiveImage.astro'

// A lightbox "enlarge" is a deliberate, on-demand view, not the byte-budget
// concern the inline responsive image exists to solve — but it still
// shouldn't force a full, unbounded re-encode of a multi-thousand-pixel
// source at build time. 2560 matches Astro's own largest built-in
// responsive-image breakpoint and comfortably exceeds any real viewport the
// lightbox's own max-h-full/max-w-full display will ever show it at.
const LIGHTBOX_MAX_WIDTH = 2560

type Props = {
    src: ImageMetadata
    alt: string
    caption: string
    width: number
    class?: string
    captionClass?: string
    imgClass?: string
} & ResponsiveImageSizing

const {
    src,
    alt,
    caption,
    width,
    class: figureClass,
    captionClass = 'mt-2 text-sm text-muted',
    imgClass,
    ...sizing
} = Astro.props

// The inline image is deliberately downscaled; the lightbox needs a full-
// resolution source of its own, handed off via `data-lightbox-src`.
const lightboxImage = await getImage({
    src,
    format: 'webp',
    width: Math.min(src.width, LIGHTBOX_MAX_WIDTH),
})
---

<figure class:list={[figureClass]}>
    <ResponsiveImage
        src={src}
        alt={alt}
        width={width}
        data-lightbox-src={lightboxImage.src}
        class:list={['rounded-xl border border-border', imgClass]}
        {...sizing}
    />
    <figcaption class:list={[captionClass]}>{caption}</figcaption>
</figure>
