---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import ResponsiveImage, {
    type ResponsiveImageSizing,
} from './ResponsiveImage.astro'

// Caps the lightbox's own re-encode instead of shipping a source at full native
// resolution — 2560 matches Astro's largest built-in responsive-image breakpoint.
const LIGHTBOX_MAX_WIDTH = 2560

type Props = {
    src: ImageMetadata
    alt: string
    caption: string
    width: number
    class?: string
    captionClass?: string
    imgClass?: string
} & ResponsiveImageSizing

const {
    src,
    alt,
    caption,
    width,
    class: figureClass,
    captionClass,
    imgClass,
    ...sizing
} = Astro.props

// The inline image is deliberately downscaled; the lightbox needs a full-
// resolution source of its own, handed off via `data-lightbox-src`.
const lightboxImage = await getImage({
    src,
    format: 'webp',
    width: Math.min(src.width, LIGHTBOX_MAX_WIDTH),
})
---

<figure class:list={[figureClass]}>
    <ResponsiveImage
        src={src}
        alt={alt}
        width={width}
        data-lightbox-src={lightboxImage.src}
        class:list={['rounded-xl border border-border', imgClass]}
        {...sizing}
    />
    <figcaption class:list={['mt-2 text-sm text-muted italic', captionClass]}>
        {caption}
    </figcaption>
</figure>
