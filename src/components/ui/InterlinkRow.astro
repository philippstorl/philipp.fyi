---
import InterlinkCard from './InterlinkCard.astro'

interface Props {
    items: Array<{ href: string; eyebrow: string; label: string }>
    class?: string
}

const { items, class: className } = Astro.props
---

{/* role="list" and grid-cols-1 li: see WorkGrid.astro. */}
<ul
    role="list"
    class:list={['grid grid-cols-1 gap-4 sm:grid-cols-3', className]}
>
    {items.map((item) => <li class="grid grid-cols-1">
        <InterlinkCard {...item} />
    </li>)}
</ul>
