---
import InterlinkCard from './InterlinkCard.astro'

interface Props {
    items: Array<{ href: string; eyebrow: string; label: string }>
    class?: string
}

const { items, class: className } = Astro.props
---

<div class:list={['grid grid-cols-1 gap-4 sm:grid-cols-3', className]}>
    {items.map((item) => <InterlinkCard {...item} />)}
</div>
