---
import { ChevronDown } from 'lucide-react'
import CareerDates from './CareerDates.astro'
import { career } from '@/data/career'
import { getPublishedEntries } from '@/utils/collections'
import { getEntrySpan } from '@/utils/career'
import { stripContentExtension } from '@/utils/slug'

const caseStudyTitles = new Map(
    (await getPublishedEntries('work')).map((entry) => [
        stripContentExtension(entry.id),
        entry.data.title,
    ]),
)

function caseStudyLinks(slugs: string[] = []) {
    return slugs.map((slug) => {
        const title = caseStudyTitles.get(slug)
        if (!title)
            throw new Error(`career.ts links unknown case study "${slug}"`)
        return { href: `/work/${slug}/`, title }
    })
}

const headingId = 'experience-heading'
---

<section aria-labelledby={headingId} class="mt-16">
    <h2
        id={headingId}
        class="mb-8 font-display text-2xl leading-snug font-bold tracking-tight text-foreground md:text-3xl"
    >
        Experience
    </h2>

    <ol role="list" class="flex flex-col gap-12">
        {career.map((entry) => <li>
            <h3
                class="font-display text-xl leading-snug font-bold tracking-tight text-foreground"
            >
                {entry.company}
            </h3>
            {entry.roles.length > 1 && (
                <CareerDates {...getEntrySpan(entry)} class="mt-1" />
            )}

            <ol
                role="list"
                class="mt-6 flex flex-col gap-10 border-l border-border pl-6"
            >
                {entry.roles.map((role) => <li class="relative">
                    <span
                        aria-hidden="true"
                        class="absolute top-1.5 -left-[1.8125rem] size-2.5 rounded-full bg-border-strong"
                    />
                    <h4 class="font-bold text-foreground">{role.title}</h4>
                    <CareerDates
                        start={role.start}
                        end={role.end}
                        class="mt-1"
                    />
                    {role.highlights.length > 0 && <details class="group mt-1">
                        <summary
                            class="inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 text-sm text-muted transition-colors duration-150 hover:text-foreground print:hidden [&::-webkit-details-marker]:hidden"
                        >
                            <span class="group-open:hidden"
                                >Show {role.highlights.length} highlights</span
                            >
                            <span class="hidden group-open:inline"
                                >Hide highlights</span
                            >
                            <ChevronDown
                                size={16}
                                strokeWidth={1.75}
                                className="motion-safe:transition-transform group-open:rotate-180"
                                aria-hidden="true"
                                focusable="false"
                            />
                        </summary>
                        <ul
                            class="mt-2 list-disc space-y-2 pl-5 text-sm leading-relaxed text-muted marker:text-border-strong md:text-base"
                        >
                            {role.highlights.map((highlight) => <li>
                                {highlight}
                            </li>)}
                        </ul>
                    </details>}
                    {(role.caseStudies?.length ?? 0) > 0 && <div class="mt-3">
                        <p class="text-xs font-medium text-muted">
                            Case studies
                        </p>
                        <ul
                            role="list"
                            class="mt-1.5 flex flex-col gap-1.5 text-sm"
                        >
                            {caseStudyLinks(role.caseStudies).map((link) => <li>
                                <a
                                    href={link.href}
                                    class="inline-flex items-center gap-1.5 text-accent"
                                >
                                    {link.title}
                                    <span aria-hidden="true">→</span>
                                </a>
                            </li>)}
                        </ul>
                    </div>}
                </li>)}
            </ol>
        </li>)}
    </ol>
</section>
