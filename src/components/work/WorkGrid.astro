---
import { getPublishedEntries } from '@/utils/collections'
import WorkCard from './WorkCard.astro'

interface Props {
    /** Eagerly loads the mobile LCP cover and the first desktop-row cover. Only pass where a work card is actually the LCP -- not on the homepage, where Hero's <h1> is. */
    eagerLoadFirst?: boolean
    /** Forwarded to WorkCard: h3 under a page's own h2 (homepage), h2 when the grid sits directly under an h1 (/work/). */
    headingLevel?: 'h2' | 'h3'
}

const { eagerLoadFirst = false, headingLevel = 'h3' } = Astro.props

const entries = (await getPublishedEntries('work')).sort(
    (a, b) => a.data.order - b.data.order,
)

// Lowest `order` gets the wide card, so a tie would pick it arbitrarily.
const orders = entries.map((entry) => entry.data.order)
if (new Set(orders).size !== orders.length) {
    throw new Error(
        `Duplicate \`order\` values in the work collection: ${orders.join(', ')}`,
    )
}
---

{/* role="list": Safari drops list semantics once list-style is none.
    Each li is grid grid-cols-1 so the card stretches to the row height
    without its min-content width (e.g. truncated text) widening the page. */}
<ol role="list" class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {entries.map((entry, i) => <li
        class:list={['grid grid-cols-1', i === 0 && 'md:col-span-3']}
    >
        <WorkCard
            entry={entry}
            featured={i === 0}
            showCover={i !== 0}
            priority={eagerLoadFirst && i < 2}
            headingLevel={headingLevel}
        />
    </li>)}
</ol>
