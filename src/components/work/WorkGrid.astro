---
import { getPublishedEntries } from '@/utils/collections'
import WorkCard from './WorkCard.astro'

interface Props {
    /** Eagerly loads the true LCP candidate. Only pass where a work card is actually the LCP -- not on the homepage, where Hero's <h1> is. */
    eagerLoadFirst?: boolean
    /** Forwarded to WorkCard: h3 under a page's own h2 (homepage), h2 when the grid sits directly under an h1 (/work/). */
    headingLevel?: 'h2' | 'h3'
}

const { eagerLoadFirst = false, headingLevel = 'h3' } = Astro.props

const entries = (await getPublishedEntries('work')).sort(
    (a, b) => a.data.order - b.data.order,
)

// Lowest `order` gets the wide card, so a tie would pick it arbitrarily.
const orders = entries.map((entry) => entry.data.order)
if (new Set(orders).size !== orders.length) {
    throw new Error(
        `Duplicate \`order\` values in the work collection: ${orders.join(', ')}`,
    )
}

const [featured, ...rest] = entries
const [firstRest, ...remainingRest] = rest
---

<div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {featured && <div class="md:col-span-3">
        <WorkCard
            entry={featured}
            featured
            showCover={false}
            priority={eagerLoadFirst}
            headingLevel={headingLevel}
        />
    </div>}
    {firstRest && (
        <WorkCard
            entry={firstRest}
            priority={eagerLoadFirst}
            headingLevel={headingLevel}
        />
    )}
    {remainingRest.map((entry) => (
        <WorkCard entry={entry} headingLevel={headingLevel} />
    ))}
</div>
