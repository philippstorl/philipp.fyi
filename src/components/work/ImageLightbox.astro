---
import { X, ChevronLeft, ChevronRight } from 'lucide-react'
---

<dialog
    id="lightbox"
    aria-label="Enlarged screenshot"
    class="m-0 max-h-none max-w-none border-none bg-black/90 p-0"
>
    <div class="relative flex h-dvh w-dvw flex-col p-4">
        <button
            id="lightbox-close"
            type="button"
            aria-label="Close"
            class="lightbox-btn absolute z-10 flex h-11 w-11 items-center justify-center rounded-full bg-black/60 text-white ring-1 ring-white/15 transition-colors hover:bg-black/80"
        >
            <X
                size={20}
                strokeWidth={1.75}
                aria-hidden="true"
                focusable="false"
            />
        </button>
        <button
            id="lightbox-prev"
            type="button"
            aria-label="Previous image"
            class="lightbox-btn absolute top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white ring-1 ring-white/15 transition-colors hover:bg-black/80 disabled:opacity-0"
        >
            <ChevronLeft
                size={20}
                strokeWidth={1.75}
                aria-hidden="true"
                focusable="false"
            />
        </button>
        <button
            id="lightbox-next"
            type="button"
            aria-label="Next image"
            class="lightbox-btn absolute top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white ring-1 ring-white/15 transition-colors hover:bg-black/80 disabled:opacity-0"
        >
            <ChevronRight
                size={20}
                strokeWidth={1.75}
                aria-hidden="true"
                focusable="false"
            />
        </button>

        <div
            id="lightbox-track"
            class="flex flex-1 snap-x snap-mandatory overflow-x-auto"
        >
        </div>

        <div class="shrink-0 pt-3 text-center" aria-live="polite">
            <p id="lightbox-caption" class="text-sm text-white/90"></p>
            <p id="lightbox-counter" class="mt-1 text-xs text-white/50"></p>
        </div>
    </div>
</dialog>

<style>
    #lightbox-close {
        top: max(0.75rem, env(safe-area-inset-top));
        right: max(0.75rem, env(safe-area-inset-right));
    }

    #lightbox-prev {
        left: max(0.5rem, env(safe-area-inset-left));
    }

    #lightbox-next {
        right: max(0.5rem, env(safe-area-inset-right));
    }

    .lightbox-slide {
        scroll-snap-stop: always;
    }
</style>

<script>
    // Astro's view-transitions router swaps page content client-side rather
    // than doing a full reload, but a <script> module's top-level code only
    // ever runs once per browser session (standard ES module behavior) — so
    // navigating away and back to a case study would leave its new figures
    // without listeners. Re-running setup on astro:page-load (which fires
    // after the initial load too) keeps it working across every navigation.
    function initLightbox() {
        const dialog = document.getElementById(
            'lightbox',
        ) as HTMLDialogElement | null
        const track = document.getElementById('lightbox-track')
        const caption = document.getElementById('lightbox-caption')
        const counter = document.getElementById('lightbox-counter')
        const closeBtn = document.getElementById(
            'lightbox-close',
        ) as HTMLButtonElement | null
        const prevBtn = document.getElementById(
            'lightbox-prev',
        ) as HTMLButtonElement | null
        const nextBtn = document.getElementById(
            'lightbox-next',
        ) as HTMLButtonElement | null
        const proseRoot = document.querySelector('.prose')

        if (
            !dialog ||
            !track ||
            !caption ||
            !counter ||
            !closeBtn ||
            !prevBtn ||
            !nextBtn ||
            !proseRoot
        ) {
            return
        }

        // Every screenshot in the case study is one gallery, in document
        // order — prev/next steps through the whole article, not just the
        // section the clicked image happened to be grouped in.
        const figures = Array.from(proseRoot.querySelectorAll('figure')).filter(
            (figure) => figure.querySelector('img'),
        )

        let currentIndex = 0
        let lastTrigger: HTMLElement | null = null
        let scrollTimeout: ReturnType<typeof setTimeout>

        // Checked at call time (not cached) so a mid-session OS-level
        // preference change takes effect on the very next scroll, same as
        // the rest of the site's reduced-motion gating.
        const prefersReducedMotion = () =>
            window.matchMedia('(prefers-reduced-motion: reduce)').matches

        const describe = (figure: Element) => {
            const img = figure.querySelector('img')
            const figcaption = figure.querySelector('figcaption')
            return {
                // Prefer the full-resolution source over the inline
                // image's own deliberately-downscaled one (ResponsiveFigure.astro).
                src: img?.dataset.lightboxSrc || img?.src || '',
                alt: img?.alt || '',
                caption: figcaption?.textContent?.trim() || '',
            }
        }

        // Read each figure's image/caption once, up front — navigation only
        // ever reads from this array instead of re-querying the live DOM on
        // every prev/next/swipe step.
        const slides = figures.map(describe)
        const slideElements: HTMLDivElement[] = []

        const updateCaption = () => {
            const slide = slides[currentIndex]
            if (!slide) return
            caption.textContent = slide.caption
            counter.textContent =
                figures.length > 1
                    ? `${currentIndex + 1} / ${figures.length}`
                    : ''
            prevBtn.disabled = currentIndex === 0
            nextBtn.disabled = currentIndex === figures.length - 1
            // Only the active slide should be reachable by a linear
            // accessibility-tree walk — otherwise every slide's image is
            // exposed at once, ahead of the caption that announces which
            // one is current.
            slideElements.forEach((slide, index) => {
                if (index === currentIndex) slide.removeAttribute('aria-hidden')
                else slide.setAttribute('aria-hidden', 'true')
            })
        }

        const syncFromScroll = () => {
            if (!track.clientWidth) return
            const rawIndex = track.scrollLeft / track.clientWidth
            const index = Math.round(rawIndex)
            // scroll-snap guarantees a genuinely settled position sits almost
            // exactly on a slide boundary. A reading that doesn't — e.g. a
            // stale scrollend firing mid-flight because goTo() retargeted the
            // scroll before the previous one settled — isn't trustworthy;
            // skip it rather than let it stomp an index goTo() already set.
            const isSettled = Math.abs(rawIndex - index) < 0.02
            if (!isSettled) return
            if (
                index !== currentIndex &&
                index >= 0 &&
                index < figures.length
            ) {
                currentIndex = index
                updateCaption()
            }
        }

        const goTo = (index: number) => {
            const clamped = Math.max(0, Math.min(index, figures.length - 1))
            // Button/keyboard navigation knows its destination immediately —
            // update the caption right away instead of waiting for the
            // (debounced, post-animation) scroll-driven sync to catch up,
            // which made the caption visibly lag behind the image.
            if (clamped !== currentIndex) {
                currentIndex = clamped
                updateCaption()
            }
            track.scrollTo({
                left: clamped * track.clientWidth,
                behavior: prefersReducedMotion() ? 'instant' : 'smooth',
            })
        }

        const openLightbox = (index: number, trigger: HTMLElement) => {
            currentIndex = index
            lastTrigger = trigger

            dialog.showModal()
            // Always instant regardless of motion preference — this is the
            // initial jump to the clicked slide, not a navigation animation,
            // and sliding through every image in between on open would look
            // broken either way.
            track.scrollTo({
                left: index * track.clientWidth,
                behavior: 'instant',
            })
            updateCaption()
        }

        // Slides are built once, up front, rather than per-open — it's the
        // same gallery every time, just starting at a different index. Most
        // sit off-screen in the horizontal track, so `loading="lazy"` lets
        // the browser defer fetching/decoding them until they're actually
        // scrolled near, instead of loading all of them on page load.
        for (const { src, alt } of slides) {
            const slide = document.createElement('div')
            slide.className =
                'lightbox-slide flex h-full w-full shrink-0 snap-center items-center justify-center'
            const img = document.createElement('img')
            img.loading = 'lazy'
            img.decoding = 'async'
            img.src = src
            img.alt = alt
            img.className = 'max-h-full max-w-full object-contain'
            slide.appendChild(img)
            track.appendChild(slide)
            slideElements.push(slide)
        }

        const multiple = figures.length > 1
        prevBtn.style.display = multiple ? '' : 'none'
        nextBtn.style.display = multiple ? '' : 'none'

        figures.forEach((figure, index) => {
            const img = figure.querySelector('img')
            if (!img) return
            img.classList.add('cursor-zoom-in')
            img.tabIndex = 0
            img.setAttribute('role', 'button')
            img.setAttribute('aria-label', `Enlarge image: ${img.alt}`)
            img.addEventListener('click', () => openLightbox(index, img))
            img.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault()
                    openLightbox(index, img)
                }
            })
        })

        track.addEventListener('scroll', () => {
            clearTimeout(scrollTimeout)
            scrollTimeout = setTimeout(syncFromScroll, 80)
        })
        // Swipe gestures don't have a known destination ahead of time like
        // goTo() does — sync as soon as the browser reports scrolling has
        // truly stopped, rather than waiting on the debounce above (kept as
        // a fallback for browsers without scrollend support).
        track.addEventListener('scrollend', syncFromScroll)

        prevBtn.addEventListener('click', () => goTo(currentIndex - 1))
        nextBtn.addEventListener('click', () => goTo(currentIndex + 1))
        closeBtn.addEventListener('click', () => dialog.close())

        dialog.addEventListener('click', (event) => {
            // The dialog's content fills the viewport, so there's no exposed
            // ::backdrop to click — treat any click outside the image/buttons
            // as a "tap to dismiss" instead.
            const target = event.target as HTMLElement
            if (!target.closest('button, img')) dialog.close()
        })

        dialog.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowLeft') goTo(currentIndex - 1)
            if (event.key === 'ArrowRight') goTo(currentIndex + 1)
        })

        dialog.addEventListener('close', () => {
            lastTrigger?.focus()
        })
    }

    document.addEventListener('astro:page-load', initLightbox)
</script>
