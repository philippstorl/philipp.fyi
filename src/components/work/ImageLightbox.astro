---
import { X, ChevronLeft, ChevronRight } from 'lucide-react'
---

<dialog
    id="lightbox"
    aria-label="Enlarged screenshot"
    class="m-0 max-h-none max-w-none border-none bg-black/90 p-0"
>
    <div class="relative flex h-dvh w-dvw flex-col p-4">
        <button
            id="lightbox-close"
            type="button"
            aria-label="Close"
            class="lightbox-btn absolute z-10 flex h-11 w-11 items-center justify-center rounded-full bg-black/60 text-white ring-1 ring-white/15 forced-colors:border transition-colors hover:bg-black/80"
        >
            <X
                size={20}
                strokeWidth={1.75}
                aria-hidden="true"
                focusable="false"
            />
        </button>
        <button
            id="lightbox-prev"
            type="button"
            aria-label="Previous image"
            class="lightbox-btn absolute top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white ring-1 ring-white/15 forced-colors:border transition-colors hover:bg-black/80 disabled:opacity-0"
        >
            <ChevronLeft
                size={20}
                strokeWidth={1.75}
                aria-hidden="true"
                focusable="false"
            />
        </button>
        <button
            id="lightbox-next"
            type="button"
            aria-label="Next image"
            class="lightbox-btn absolute top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 text-white ring-1 ring-white/15 forced-colors:border transition-colors hover:bg-black/80 disabled:opacity-0"
        >
            <ChevronRight
                size={20}
                strokeWidth={1.75}
                aria-hidden="true"
                focusable="false"
            />
        </button>

        {/* Focusable for axe scrollable-region-focusable (Safari); arrows are handled at dialog level.
            White inset ring: the accent fails 3:1 against the near-black backdrop. */}
        {/* eslint-disable jsx-a11y/no-noninteractive-tabindex */}
        <div
            id="lightbox-track"
            tabindex="0"
            role="region"
            aria-label="Screenshot gallery"
            class="flex flex-1 snap-x snap-mandatory overflow-x-auto focus-visible:-outline-offset-2 focus-visible:outline-white"
        ></div>
        {/* eslint-enable jsx-a11y/no-noninteractive-tabindex */}

        <div class="shrink-0 pt-3 text-center" aria-live="polite">
            <p id="lightbox-caption" class="text-sm text-white/90 italic"></p>
            <p id="lightbox-counter" class="mt-1 text-xs text-white/50"></p>
        </div>
    </div>
</dialog>

<style>
    #lightbox-close {
        top: max(0.75rem, env(safe-area-inset-top));
        right: max(0.75rem, env(safe-area-inset-right));
    }

    #lightbox-prev {
        left: max(0.5rem, env(safe-area-inset-left));
    }

    #lightbox-next {
        right: max(0.5rem, env(safe-area-inset-right));
    }

    .lightbox-slide {
        scroll-snap-stop: always;
    }

    /* Inset onto the button's own dark fill: outside it, the ring sits over the
       backdrop or screenshot, which the accent (or white) fails 3:1 against. */
    .lightbox-btn:focus-visible {
        outline-color: white;
        outline-offset: -5px;
    }
</style>

<script>
    // Module top-level code runs once per session -- re-run on astro:page-load
    // so a soft nav's new figures don't end up without listeners.
    function initLightbox() {
        const dialog = document.getElementById(
            'lightbox',
        ) as HTMLDialogElement | null
        const track = document.getElementById('lightbox-track')
        const caption = document.getElementById('lightbox-caption')
        const counter = document.getElementById('lightbox-counter')
        const closeBtn = document.getElementById(
            'lightbox-close',
        ) as HTMLButtonElement | null
        const prevBtn = document.getElementById(
            'lightbox-prev',
        ) as HTMLButtonElement | null
        const nextBtn = document.getElementById(
            'lightbox-next',
        ) as HTMLButtonElement | null
        const proseRoot = document.querySelector('.prose')

        if (
            !dialog ||
            !track ||
            !caption ||
            !counter ||
            !closeBtn ||
            !prevBtn ||
            !nextBtn ||
            !proseRoot
        ) {
            return
        }

        // Whole article is one gallery, in document order.
        const figures = Array.from(proseRoot.querySelectorAll('figure')).filter(
            (figure) => figure.querySelector('img'),
        )

        let currentIndex = 0
        let lastTrigger: HTMLElement | null = null
        let scrollTimeout: ReturnType<typeof setTimeout>
        // Slide goTo() is scrolling to; settled readings elsewhere are stale
        // (queued before its scroll moved the track) until it lands.
        let scrollTarget: number | null = null

        // Checked at call time so a live preference change applies immediately.
        const prefersReducedMotion = () =>
            window.matchMedia('(prefers-reduced-motion: reduce)').matches

        const describe = (figure: Element) => {
            const img = figure.querySelector('img')
            const figcaption = figure.querySelector('figcaption')
            return {
                // Full-resolution src, not the downscaled inline one.
                src: img?.dataset.lightboxSrc || img?.src || '',
                alt: img?.alt || '',
                caption: figcaption?.textContent?.trim() || '',
            }
        }

        // Read once, up front -- nav reads this array, not the live DOM.
        const slides = figures.map(describe)
        const slideElements: HTMLDivElement[] = []

        const updateCaption = () => {
            const slide = slides[currentIndex]
            if (!slide) return
            caption.textContent = slide.caption
            counter.textContent =
                figures.length > 1
                    ? `${currentIndex + 1} / ${figures.length}`
                    : ''
            const focused = document.activeElement
            prevBtn.disabled = currentIndex === 0
            nextBtn.disabled = currentIndex === figures.length - 1
            // Disabling the focused button drops focus to <body>, outside the
            // dialog, which kills arrow-key nav. Track, not the other button,
            // so repeated Enter doesn't start walking back the other way.
            if (
                (focused === prevBtn && prevBtn.disabled) ||
                (focused === nextBtn && nextBtn.disabled)
            ) {
                track.focus()
            }
            // Only active slide in the a11y tree, not every image at once.
            slideElements.forEach((slide, index) => {
                if (index === currentIndex) slide.removeAttribute('aria-hidden')
                else slide.setAttribute('aria-hidden', 'true')
            })
        }

        const syncFromScroll = () => {
            if (!track.clientWidth) return
            const rawIndex = track.scrollLeft / track.clientWidth
            const index = Math.round(rawIndex)
            // A settled scroll sits near a slide boundary; a stale mid-flight
            // reading shouldn't stomp an index goTo() already set.
            const isSettled = Math.abs(rawIndex - index) < 0.02
            if (!isSettled) return
            if (scrollTarget !== null) {
                if (index !== scrollTarget) return
                scrollTarget = null
            }
            if (
                index !== currentIndex &&
                index >= 0 &&
                index < figures.length
            ) {
                currentIndex = index
                updateCaption()
            }
        }

        const goTo = (index: number) => {
            clearTimeout(scrollTimeout)
            const clamped = Math.max(0, Math.min(index, figures.length - 1))
            // Update immediately -- don't wait on the debounced scroll sync.
            if (clamped !== currentIndex) {
                currentIndex = clamped
                updateCaption()
            }
            // Already there: no scroll event would ever clear the target.
            // Compared in slides, since scrollLeft can be fractional.
            const alreadyThere =
                Math.abs(track.scrollLeft / track.clientWidth - clamped) < 0.02
            scrollTarget = alreadyThere ? null : clamped
            track.scrollTo({
                left: clamped * track.clientWidth,
                behavior: prefersReducedMotion() ? 'instant' : 'smooth',
            })
        }

        const openLightbox = (index: number, trigger: HTMLElement) => {
            currentIndex = index
            lastTrigger = trigger
            scrollTarget = null

            dialog.showModal()
            // Always instant -- initial jump, not a navigation animation.
            track.scrollTo({
                left: index * track.clientWidth,
                behavior: 'instant',
            })
            updateCaption()
        }

        // Built once, up front -- same gallery every time. Most sit
        // off-screen, so loading="lazy" defers fetch until scrolled near.
        for (const { src, alt } of slides) {
            const slide = document.createElement('div')
            slide.className =
                'lightbox-slide flex h-full w-full shrink-0 snap-center items-center justify-center'
            const img = document.createElement('img')
            img.loading = 'lazy'
            img.decoding = 'async'
            img.src = src
            img.alt = alt
            img.className = 'max-h-full max-w-full object-contain'
            slide.appendChild(img)
            track.appendChild(slide)
            slideElements.push(slide)
        }

        const multiple = figures.length > 1
        prevBtn.style.display = multiple ? '' : 'none'
        nextBtn.style.display = multiple ? '' : 'none'

        figures.forEach((figure, index) => {
            const img = figure.querySelector('img')
            if (!img) return
            img.classList.add('cursor-zoom-in')
            img.tabIndex = 0
            img.setAttribute('role', 'button')
            img.setAttribute('aria-label', `Enlarge image: ${img.alt}`)
            img.addEventListener('click', () => openLightbox(index, img))
            img.addEventListener('keydown', (event) => {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault()
                    openLightbox(index, img)
                }
            })
        })

        track.addEventListener('scroll', () => {
            clearTimeout(scrollTimeout)
            scrollTimeout = setTimeout(syncFromScroll, 80)
        })
        // Swipe has no known destination -- sync on scrollend; debounce
        // above is a fallback for browsers without it.
        track.addEventListener('scrollend', syncFromScroll)
        // A swipe, wheel or key scroll takes over from goTo()'s scroll, so
        // wherever it settles is real. Mouse presses and non-scrolling keys
        // don't move the track, so they keep the guard.
        const releaseScrollTarget = () => {
            scrollTarget = null
        }
        const scrollKeys = new Set(['Home', 'End', 'PageUp', 'PageDown', ' '])
        track.addEventListener('pointerdown', (event) => {
            if (event.pointerType !== 'mouse') releaseScrollTarget()
        })
        track.addEventListener('wheel', releaseScrollTarget, { passive: true })
        track.addEventListener('keydown', (event) => {
            if (scrollKeys.has(event.key)) releaseScrollTarget()
        })

        prevBtn.addEventListener('click', () => goTo(currentIndex - 1))
        nextBtn.addEventListener('click', () => goTo(currentIndex + 1))
        closeBtn.addEventListener('click', () => dialog.close())

        dialog.addEventListener('click', (event) => {
            // No exposed ::backdrop -- any click outside image/buttons dismisses.
            const target = event.target as HTMLElement
            if (!target.closest('button, img')) dialog.close()
        })

        dialog.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return
            // Leave Alt/Cmd+Arrow history navigation alone.
            if (event.altKey || event.metaKey || event.ctrlKey) return
            // Stop a focused track's native scroll from racing goTo()'s own.
            event.preventDefault()
            goTo(currentIndex + (event.key === 'ArrowLeft' ? -1 : 1))
        })

        dialog.addEventListener('close', () => {
            lastTrigger?.focus()
        })
    }

    document.addEventListener('astro:page-load', initLightbox)
</script>
