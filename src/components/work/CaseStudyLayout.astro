---
import ImageLightbox from './ImageLightbox.astro'
import CategoryBadge from '@/components/ui/CategoryBadge.astro'
import JsonLd from '@/components/seo/JsonLd.astro'
import type { WorkCategory } from '@/utils/category-colors'
import { PROSE_BLOCKQUOTE_CLASSES } from '@/utils/prose'
import { buildCreativeWorkSchema } from '@/utils/schema'
import { toAbsoluteUrl } from '@/utils/url'

interface Props {
    title: string
    description: string
    category: WorkCategory
    year: string
    tags: string[]
    /** Per-slug OG image path (e.g. "/og/work/foo.png"), reused as the schema's image */
    ogImage?: string
}

const { title, description, category, year, tags, ogImage } = Astro.props

const pageUrl = toAbsoluteUrl(Astro.url.pathname, Astro.site)
const imageUrl = ogImage ? toAbsoluteUrl(ogImage, Astro.site) : undefined
const creativeWorkSchema = buildCreativeWorkSchema({
    title,
    description,
    year,
    url: pageUrl,
    image: imageUrl,
})
---

{
    /*
    This container's width (max-w-3xl px-6) is hardcoded again as pixel
    constants in src/utils/content-image-sizing.ts (CONTAINER_CAP_PX/
    CONTAINER_CAP_BREAKPOINT/CONTAINER_PADDING_PX) for every case-study
    figure's sizes/widths math — keep both in sync if this class changes.
*/
}
<div class="mx-auto max-w-3xl px-6 py-24">
    <JsonLd data={creativeWorkSchema} />
    <a
        href="/work/"
        class="mb-12 inline-flex items-center gap-1.5 text-sm text-muted transition-colors duration-150 hover:text-accent"
    >
        ← All work
    </a>

    <header class="mt-10 mb-12">
        <div class="mb-5 flex items-center gap-3">
            <CategoryBadge category={category} />
            <span class="text-sm text-muted">{year}</span>
        </div>
        <h1
            class="mb-6 font-display text-4xl leading-tight font-normal tracking-tight text-foreground md:text-5xl"
        >
            {title}
        </h1>
        <p class="mb-8 text-lg leading-relaxed text-muted">
            {description}
        </p>

        <ul class="flex flex-wrap gap-2" aria-label="Technologies and topics">
            {
                tags.map((tag) => (
                    <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">
                        {tag}
                    </li>
                ))
            }
        </ul>
    </header>

    <hr class="mb-12 border-border" />

    <article
        class={`prose max-w-none prose-neutral dark:prose-invert prose-headings:font-display prose-headings:font-normal prose-headings:tracking-tight prose-a:text-accent prose-a:no-underline hover:prose-a:underline ${PROSE_BLOCKQUOTE_CLASSES} prose-code:font-mono prose-code:text-sm`}
    >
        <slot />
    </article>

    <ImageLightbox />

    <div class="mt-20 border-t border-border pt-10">
        <a
            href="/work/"
            class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors duration-150 hover:text-accent"
        >
            ← Back to all work
        </a>
    </div>
</div>
