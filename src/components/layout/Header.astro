---
import { navItems } from '@/data/navigation'
import ThemeToggle from '@/components/ui/ThemeToggle.astro'
import NavLink from '@/components/layout/NavLink.astro'

const pathname = Astro.url.pathname
---

{
    /* Sibling of #site-header, not a child -- nesting it would carry it into the header's own z-50 stacking context. */
}
<div
    id="mobile-nav-backdrop"
    class="animate-mobile-nav-backdrop-in fixed inset-0 z-40 hidden bg-background/60 md:hidden"
    aria-hidden="true"
    transition:persist
>
</div>

<header
    id="site-header"
    class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-sm"
    transition:persist
>
    <div
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6"
    >
        <a
            href="/"
            class="font-display text-base font-normal tracking-tight text-foreground transition-colors duration-150 hover:text-accent"
            aria-label="Philipp Storl, home"
        >
            Philipp Storl
        </a>

        <nav aria-label="Main navigation" class="hidden md:block">
            <ul class="flex items-center gap-8">
                {
                    navItems.map((item) => (
                        <li>
                            <NavLink
                                href={item.href}
                                label={item.label}
                                pathname={pathname}
                                variant="desktop"
                            />
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="flex items-center gap-1">
            <ThemeToggle />

            <button
                id="nav-toggle"
                aria-label="Toggle navigation"
                aria-expanded="false"
                aria-controls="mobile-nav"
                class="flex h-11 w-11 items-center justify-center rounded-md text-muted transition-colors duration-150 hover:bg-card hover:text-foreground md:hidden"
            >
                <svg
                    id="icon-menu"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <line x1="4" x2="20" y1="12" y2="12"></line>
                    <line x1="4" x2="20" y1="6" y2="6"></line>
                    <line x1="4" x2="20" y1="18" y2="18"></line>
                </svg>
                <svg
                    id="icon-close"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="hidden"
                >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <nav
        id="mobile-nav"
        aria-label="Mobile navigation"
        class="animate-mobile-nav-in absolute inset-x-0 top-full hidden border-t border-b border-border bg-background md:hidden"
    >
        <ul class="mx-auto flex max-w-6xl flex-col px-6 py-4">
            {
                navItems.map((item) => (
                    <li>
                        <NavLink
                            href={item.href}
                            label={item.label}
                            pathname={pathname}
                            variant="mobile"
                        />
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<script>
    import {
        isNavLinkActive,
        NAV_LINK_ACTIVE_CLASS,
        NAV_LINK_INACTIVE_CLASSES,
        NAV_LINK_UNDERLINE_ACTIVE_CLASS,
    } from '@/utils/nav-active'

    // Header is transition:persist'ed, so re-run on astro:page-load to
    // keep the active-link class in sync with the new URL.
    function setLinkActive(link: Element, isActive: boolean) {
        link.classList.toggle(NAV_LINK_ACTIVE_CLASS, isActive)
        NAV_LINK_INACTIVE_CLASSES.forEach((cls) =>
            link.classList.toggle(cls, !isActive),
        )
        link.classList.toggle(NAV_LINK_UNDERLINE_ACTIVE_CLASS, isActive)
        if (isActive) {
            link.setAttribute('aria-current', 'page')
        } else {
            link.removeAttribute('aria-current')
        }
    }

    function updateActiveNav() {
        const { pathname } = window.location

        document
            .querySelectorAll('#site-header a[data-nav-link]')
            .forEach((link) => {
                const href = link.getAttribute('href')
                setLinkActive(link, !!href && isNavLinkActive(pathname, href))
            })
    }

    updateActiveNav()
    document.addEventListener('astro:page-load', updateActiveNav)

    const toggle = document.getElementById('nav-toggle')
    const nav = document.getElementById('mobile-nav')
    const backdrop = document.getElementById('mobile-nav-backdrop')
    const iconMenu = document.getElementById('icon-menu')
    const iconClose = document.getElementById('icon-close')

    // Looked up fresh each time -- unlike <header>, these aren't
    // transition:persist'ed, so a soft nav swaps in new nodes.
    function getMainContent() {
        return document.getElementById('main-content')
    }
    function getSiteFooter() {
        return document.getElementById('site-footer')
    }

    function openMenu() {
        nav?.classList.remove('hidden')
        backdrop?.classList.remove('hidden')
        toggle?.setAttribute('aria-expanded', 'true')
        iconMenu?.classList.add('hidden')
        iconClose?.classList.remove('hidden')
        // Keep Tab from reaching background content while the overlay is open.
        getMainContent()?.setAttribute('inert', '')
        getSiteFooter()?.setAttribute('inert', '')
    }

    function closeMenu({ focusToggle = false } = {}) {
        nav?.classList.add('hidden')
        backdrop?.classList.add('hidden')
        toggle?.setAttribute('aria-expanded', 'false')
        iconMenu?.classList.remove('hidden')
        iconClose?.classList.add('hidden')
        getMainContent()?.removeAttribute('inert')
        getSiteFooter()?.removeAttribute('inert')
        if (focusToggle) toggle?.focus()
    }

    // Checks computed display, not the hidden class -- nav also has
    // md:hidden, so a resize past that breakpoint would otherwise leave
    // this reporting true.
    function isMenuOpen() {
        return !!nav && getComputedStyle(nav).display !== 'none'
    }

    toggle?.addEventListener('click', () => {
        if (isMenuOpen()) closeMenu()
        else openMenu()
    })

    nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => closeMenu())
    })

    // APG disclosure pattern: Escape closes and refocuses the toggle;
    // an outside click closes without stealing focus.
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isMenuOpen()) {
            closeMenu({ focusToggle: true })
        }
    })

    document.addEventListener('click', (event) => {
        if (!isMenuOpen()) return
        const target = event.target as Node
        if (!nav?.contains(target) && !toggle?.contains(target)) {
            closeMenu()
        }
    })

    // inert has no media-query fallback -- close the menu once the
    // viewport crosses md so main/footer can't stay stranded inert.
    window
        .matchMedia('(min-width: 768px)')
        .addEventListener('change', (event) => {
            if (event.matches) closeMenu()
        })
</script>
