---
import { navItems } from '@/data/navigation'
import ThemeToggle from '@/components/ui/ThemeToggle'
import NavLink from '@/components/layout/NavLink.astro'

const pathname = Astro.url.pathname
---

<header
    id="site-header"
    class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-sm"
    transition:persist
>
    <div
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6"
    >
        <a
            href="/"
            class="font-display text-base font-normal tracking-tight text-foreground transition-colors duration-150 hover:text-accent"
            aria-label="Philipp Storl, home"
        >
            Philipp Storl
        </a>

        <nav aria-label="Main navigation" class="hidden md:block">
            <ul class="flex items-center gap-8">
                {
                    navItems.map((item) => (
                        <li>
                            <NavLink
                                href={item.href}
                                label={item.label}
                                pathname={pathname}
                                variant="desktop"
                            />
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="flex items-center gap-1">
            <ThemeToggle client:load />
            {
                /* Runs synchronously, before ThemeToggle's client:load hydration
                (a deferred module script), and before the browser paints —
                correcting the buttons' aria-pressed/class from localStorage so
                the SSR-baked 'system' state is never visible. Mirrors
                BaseLayout.astro's dark-mode pre-paint script; ThemeToggle.tsx's
                getStoredTheme() computes the same value so hydration matches
                what this script already put in the DOM instead of mismatching it. */
            }
            <script is:inline>
                ;(function () {
                    try {
                        const stored = localStorage.getItem('theme')
                        const theme =
                            stored === 'light' || stored === 'dark'
                                ? stored
                                : 'system'
                        document
                            .querySelectorAll('[data-theme-value]')
                            .forEach(function (btn) {
                                const active =
                                    btn.getAttribute('data-theme-value') ===
                                    theme
                                btn.setAttribute(
                                    'aria-pressed',
                                    active ? 'true' : 'false',
                                )
                                btn.classList.toggle('bg-accent/10', active)
                                btn.classList.toggle('text-accent', active)
                                btn.classList.toggle('text-muted', !active)
                                btn.classList.toggle(
                                    'hover:bg-foreground/5',
                                    !active,
                                )
                                btn.classList.toggle(
                                    'hover:text-foreground',
                                    !active,
                                )
                            })
                    } catch {
                        // no-op: if localStorage is unavailable, leave
                        // ThemeToggle's SSR-baked 'system' state as-is.
                    }
                })()
            </script>

            <button
                id="nav-toggle"
                aria-label="Toggle navigation"
                aria-expanded="false"
                aria-controls="mobile-nav"
                class="flex h-11 w-11 items-center justify-center rounded-md text-muted transition-colors duration-150 hover:bg-card hover:text-foreground md:hidden"
            >
                <svg
                    id="icon-menu"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <line x1="4" x2="20" y1="12" y2="12"></line>
                    <line x1="4" x2="20" y1="6" y2="6"></line>
                    <line x1="4" x2="20" y1="18" y2="18"></line>
                </svg>
                <svg
                    id="icon-close"
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="hidden"
                >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <nav
        id="mobile-nav"
        aria-label="Mobile navigation"
        class="hidden border-t border-border md:hidden"
    >
        <ul class="mx-auto flex max-w-6xl flex-col px-6 py-4">
            {
                navItems.map((item) => (
                    <li>
                        <NavLink
                            href={item.href}
                            label={item.label}
                            pathname={pathname}
                            variant="mobile"
                        />
                    </li>
                ))
            }
        </ul>
    </nav>
</header>

<script>
    import {
        isNavLinkActive,
        NAV_LINK_ACTIVE_CLASS,
        NAV_LINK_INACTIVE_CLASSES,
        NAV_LINK_UNDERLINE_ACTIVE_CLASS,
    } from '@/utils/nav-active'

    // Header persists across client-side navigations (transition:persist,
    // so the ThemeToggle island and the listeners below don't get torn down
    // on every page swap) — but that also means the nav's "active link"
    // classes, computed server-side from the page that was current when
    // this DOM was first rendered, never get recomputed for the new URL.
    // Re-running this on astro:page-load (which fires after every
    // navigation, including ones that don't re-render persisted elements)
    // keeps the active link in sync without needing a full nav re-render.
    function setLinkActive(link: Element, isActive: boolean) {
        link.classList.toggle(NAV_LINK_ACTIVE_CLASS, isActive)
        NAV_LINK_INACTIVE_CLASSES.forEach((cls) =>
            link.classList.toggle(cls, !isActive),
        )
        link.classList.toggle(NAV_LINK_UNDERLINE_ACTIVE_CLASS, isActive)
        if (isActive) {
            link.setAttribute('aria-current', 'page')
        } else {
            link.removeAttribute('aria-current')
        }
    }

    function updateActiveNav() {
        const { pathname } = window.location

        document
            .querySelectorAll('#site-header a[data-nav-link]')
            .forEach((link) => {
                const href = link.getAttribute('href')
                setLinkActive(link, !!href && isNavLinkActive(pathname, href))
            })
    }

    updateActiveNav()
    document.addEventListener('astro:page-load', updateActiveNav)

    const toggle = document.getElementById('nav-toggle')
    const nav = document.getElementById('mobile-nav')
    const iconMenu = document.getElementById('icon-menu')
    const iconClose = document.getElementById('icon-close')

    function openMenu() {
        nav?.classList.remove('hidden')
        toggle?.setAttribute('aria-expanded', 'true')
        iconMenu?.classList.add('hidden')
        iconClose?.classList.remove('hidden')
    }

    function closeMenu({ focusToggle = false } = {}) {
        nav?.classList.add('hidden')
        toggle?.setAttribute('aria-expanded', 'false')
        iconMenu?.classList.remove('hidden')
        iconClose?.classList.add('hidden')
        if (focusToggle) toggle?.focus()
    }

    // Checks computed display, not the hidden class -- nav also has
    // md:hidden, so a resize past that breakpoint would otherwise leave
    // this reporting true.
    function isMenuOpen() {
        return !!nav && getComputedStyle(nav).display !== 'none'
    }

    toggle?.addEventListener('click', () => {
        if (isMenuOpen()) closeMenu()
        else openMenu()
    })

    nav?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => closeMenu())
    })

    // APG disclosure pattern: Escape closes and refocuses the toggle;
    // an outside click closes without stealing focus.
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isMenuOpen()) {
            closeMenu({ focusToggle: true })
        }
    })

    document.addEventListener('click', (event) => {
        if (!isMenuOpen()) return
        const target = event.target as Node
        if (!nav?.contains(target) && !toggle?.contains(target)) {
            closeMenu()
        }
    })
</script>
